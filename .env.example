# ============================================================
# RCMM - recap-en-to-mm
# ဒီဖိုင်ကို .env လို့ နာမည်ပြောင်းပြီး ကိုယ့် API Key တွေ ဖြည့်သုံးပါ။
# API Key အစစ်တွေပါတဲ့ .env ကို GitHub ပေါ် မတင်ပါနဲ့။
#
# အသုံးပြုပုံ အရင်ဖတ်ရန် -
# 1. သုံးမယ့် Provider ရဲ့ API Key ကို ရယူပြီး အောက်မှာ ဖြည့်ပါ။
# 2. Model တစ်ခုထက်ပိုပြီး ရွေးမထားပါနဲ့။ ရွေးချင်တဲ့ Model ရဲ့ # ကို ဖြုတ်ပါ။
# 3. RECAP_AI_PROVIDER=auto ထားရင် အောက်မှာ သတ်မှတ်ထားတဲ့ အစီအစဉ်အတိုင်း
#    API Key + Model နှစ်ခုလုံး ပြည့်စုံတဲ့ Provider ကို အရင်သုံးပါမယ်။
# 4. Provider တစ်ခု Limit ပြည့်သွားတာ၊ Error ဖြစ်တာမျိုးဆိုရင်
#    Fallback ထဲမှာ ပါတဲ့ နောက် Provider ကို ဆက်စမ်းပါမယ်။
# 5. ဘာ Provider မှ မပြည့်စုံရင် Gemini ကို ပြန်သုံးပါမယ်။
#
# မှတ်ချက် - Free ဆိုတာ အကန့်အသတ်မရှိတာ မဟုတ်ပါ။
# Provider တစ်ခုချင်းစီရဲ့ Free quota / Rate limit ကွာပါတယ်။
# ============================================================


# ------------------------------------------------------------
# 1. GEMINI - အဓိက Recap AI / အရန်အဖြစ်သုံးမယ့် AI
# API Key ယူရန်: https://aistudio.google.com/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=

# လက်ရှိရွေးထားတဲ့ Model
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# တခြားရွေးချယ်စရာ Model များ (တစ်ခုရွေးပြီး အပေါ်ကလိုင်းကို # ခံပါ)
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# GEMINI_TEXT_MODEL=gemini-3.6-flash
# GEMINI_TEXT_MODEL=gemini-3.7-flash
# GEMINI_TEXT_MODEL=gemini-3.8-flash

# Gemini ရဲ့ Free quota နဲ့ Model ရရှိမှုက Account / Region အလိုက် ကွာနိုင်ပါတယ်။
# AI Studio ထဲက Usage / Pricing ကိုလည်း တစ်ချက်စစ်ပါ။

# ပုံဖန်တီးတဲ့အလုပ်တွေအတွက် Google Project Key ထပ်ထည့်ချင်ရင် သုံးပါ။
# မလိုရင် ဒီတိုင်းထားခဲ့လို့ရပါတယ်။
# GEMINI_IMAGE_PROJECT_1_KEY=
# GEMINI_IMAGE_PROJECT_2_KEY=

# Internet ချိတ်ဆက်ဖို့ Proxy လိုတဲ့သူတွေအတွက်သာပါ။
# GEMINI_PROXY=http://127.0.0.1:10808
# Proxy မသုံးချင်ရင် အောက်ကလိုရေးနိုင်ပါတယ်။
# GEMINI_PROXY=none


# ------------------------------------------------------------
# 2. RECAP AI ကို ဘယ် Provider ကနေ သုံးမလဲ
# ------------------------------------------------------------

# auto = အောက်က Provider အစီအစဉ်ထဲက Key နဲ့ Model ပြည့်စုံတဲ့
#        ပထမဆုံး Provider ကို အလိုအလျောက် သုံးမယ်။
# gemini = Gemini ကိုပဲ သီးသန့်သုံးမယ်။
# groq / openrouter / cloudflare / nvidia / cohere / ollama
#        = သတ်မှတ်ထားတဲ့ Provider ကိုပဲ အဓိကထားသုံးမယ်။
RECAP_AI_PROVIDER=auto

# အရင်စမ်းမယ့်အစီအစဉ်။ ကိုယ်သုံးမယ့် Provider ကို ရှေ့တင်နိုင်ပါတယ်။
# အခုထားတဲ့အစီအစဉ်မှာ Groq ကို ပထမ၊ OpenRouter ကို ဒုတိယထားပါတယ်။
RECAP_AI_AUTO_ORDER=groq,openrouter,cloudflare,nvidia,cohere,ollama

# အဓိက Provider အလုပ်မလုပ်ရင် ဆက်စမ်းမယ့် အရန် Provider များ။
RECAP_AI_FALLBACKS=groq,openrouter,cloudflare,nvidia,cohere,ollama

# AI တစ်ခါမေးတဲ့အခါ စောင့်မယ့်အချိန် (စက္ကန့်)
RECAP_AI_TIMEOUT_SECONDS=120


# ------------------------------------------------------------
# 3. GROQ - မြန်ဆန်တဲ့ Hosted AI
# API Key ယူရန်: https://console.groq.com/keys
# ------------------------------------------------------------
GROQ_API_KEY=

# Model တစ်ခုကိုပဲ အသက်သွင်းပါ။ လက်ရှိ Default က GPT-OSS 20B ဖြစ်ပါတယ်။
GROQ_MODEL=openai/gpt-oss-20b

# အခြားရွေးချယ်စရာများ
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=qwen/qwen3.8-27b

# သတိ - Groq Free Plan မှာ သတ်မှတ်ထားတဲ့ Quota အတွင်းသာ အခမဲ့ပါ။
# Limit ပြည့်ရင် ငွေမဖြတ်ဘဲ 429 Limit Error ပြန်ပေးပါတယ်။
# Developer / Paid Plan ကို ကိုယ်တိုင်ပြောင်းပြီး Billing ဖွင့်ထားရင်
# Model အလိုက် Token သုံးစွဲခ ကျနိုင်ပါတယ်။ Account ရဲ့ Plan နဲ့ Limit ကိုစစ်ပါ။


# ------------------------------------------------------------
# 4. OPENROUTER - Free Model အမျိုးမျိုးကို တစ်နေရာတည်းက သုံးရန်
# API Key ယူရန်: https://openrouter.ai/keys
# ------------------------------------------------------------
OPENROUTER_API_KEY=

# ဒီလိုထားရင် OpenRouter က ရနိုင်တဲ့ Free Model ထဲက သင့်တော်တာကို ရွေးပေးမယ်။
OPENROUTER_MODEL=openrouter/free

# ကိုယ်တိုင် Model တစ်ခုရွေးချင်ရင် အပေါ်ကလိုင်းကို # ခံပြီး
# အောက်ကထဲက တစ်ခုကို # ဖြုတ်ပါ။ Free Model စာရင်းက အမြဲပြောင်းနိုင်ပါတယ်။
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Free Model များကြည့်ရန်:
# https://openrouter.ai/collections/free-models
# Free Model တွေမှာ Request Limit ရှိပါတယ်။ လက်ရှိစာရင်းကို အဲဒီမှာစစ်ပါ။


# ------------------------------------------------------------
# 5. CLOUDFLARE WORKERS AI - နေ့စဉ် Free Allocation ပါတဲ့ AI
# API Token ယူရန်: https://dash.cloudflare.com/profile/api-tokens
# Account ID ကို Cloudflare Dashboard ထဲမှာ ကြည့်နိုင်ပါတယ်။
# ဒီ Provider သုံးဖို့ Token နဲ့ Account ID နှစ်ခုလုံးလိုပါတယ်။
# ------------------------------------------------------------
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Cloudflare Free Plan မှာ ရနိုင်တဲ့ Model များထဲက တစ်ခုရွေးပါ။
CF_MODEL=@cf/zai-org/glm-4.7-flash
# CF_MODEL=@cf/google/gemma-4-26b-a4b-it
# CF_MODEL=@cf/nvidia/nemotron-3-120b-a12b

# Free Plan မှာ နေ့စဉ် 10,000 Neurons အထိ ပါဝင်ပါတယ်။
# Model အားလုံး Free မဟုတ်ပါဘူး။ Paid လို့ပြထားတဲ့ Model မရွေးမိအောင်
# အောက်က Catalog မှာ Free Plan ရနိုင်/မရနိုင် စစ်ပြီးမှ ပြောင်းပါ။
# https://developers.cloudflare.com/workers-ai/models/


# ------------------------------------------------------------
# 6. NVIDIA NIM - NVIDIA ရဲ့ Hosted AI Model
# API Key ယူရန်: https://build.nvidia.com/
# ------------------------------------------------------------
NVIDIA_API_KEY=

# လက်ရှိ NVIDIA API Catalog မှာ ရနိုင်တဲ့ Model ID
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Developer Program နဲ့ စမ်းသပ်အသုံးပြုဖို့ Free Endpoint ရှိပါတယ်။
# ဒါပေမဲ့ Free access က စမ်းသပ်/ဖွံ့ဖြိုးရေးအတွက်ဖြစ်ပြီး
# Limit နဲ့ အသုံးပြုခွင့်အခြေအနေတွေကို NVIDIA Account ထဲမှာ စစ်ပါ။
# ဒီ Model ရဲ့ ထုတ်ပြန်ထားတဲ့ အဓိကဘာသာစကားစာရင်းမှာ မြန်မာမပါပါဘူး။
# မြန်မာဘာသာပြန်အတွက် အရင်စမ်းကြည့်ပြီးမှ အဓိက Model အဖြစ်ရွေးပါ။


# ------------------------------------------------------------
# 7. COHERE - Trial API နဲ့ စမ်းသုံးနိုင်တဲ့ AI
# API Key ယူရန်: https://dashboard.cohere.com/api-keys
# ------------------------------------------------------------
COHERE_API_KEY=

# Command A+ ကို စမ်းသုံးရန်
COHERE_MODEL=command-a-plus-05-2026

# Trial Key မှာ တစ်လ 1,000 API Calls နဲ့ တစ်မိနစ် 20 Requests ကန့်သတ်ချက်ရှိပါတယ်။
# Command A+ ရဲ့ တရားဝင်ဘာသာစကားစာရင်းမှာ မြန်မာမပါပါဘူး။
# မြန်မာဘာသာပြန်ရလဒ်ကို အရင်စမ်းသပ်ပါ။


# ------------------------------------------------------------
# 8. OLLAMA - ကိုယ့်ကွန်ပျူတာမှာပဲ AI ကို Run မယ်
# Internet API Key မလို၊ Hosted API သုံးခ မရှိပါ။
# ဒါပေမဲ့ Model Download လုပ်ဖို့ Disk Space နဲ့ RAM လိုပါတယ်။
# Download: https://ollama.com/
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# အောက်က Model တွေထဲက တစ်ခုကိုပဲ ရွေးပြီး အရင် Download လုပ်ထားပါ။
# Default က 4B ဖြစ်ပါတယ်။
OLLAMA_MODEL=qwen3.5:4b

# ပိုပေါ့တဲ့ Model
# OLLAMA_MODEL=qwen3.5:0.8b
# OLLAMA_MODEL=qwen3.5:2b

# ပိုကြီးတဲ့ Model (RAM ပိုလိုမယ်)
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_MODEL=qwen3.5:27b

# Model Download ဥပမာ:
# ollama pull qwen3.5:4b
# ကိုယ့်စက်မှာ RCMM Run နေမှ ဒီ Local URL ကို ချိတ်နိုင်ပါတယ်။
# Cloud မှာ RCMM Run ထားရင် 127.0.0.1 က Cloud Server ကိုပဲ ဆိုလိုပါတယ်။


# ------------------------------------------------------------
# 9. MISTRAL - အပိုရွေးချယ်စရာ
# ဒီ Provider ကို Free-first အစီအစဉ်ထဲ မထည့်ထားပါ။
# Account မှာ Free Credit / Billing ရှိမရှိ အရင်စစ်ပါ။
# API Key: https://console.mistral.ai/
# ------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=

# Model ID ရွေးချယ်စရာများ - သုံးစွဲခ ရှိနိုင်ပါတယ်။
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_MODEL=ministral-3b-latest
# MISTRAL_MODEL=ministral-8b-latest


# ------------------------------------------------------------
# 10. FAL.AI - AI နဲ့ Thumbnail / Background ပုံဖန်တီးရန်
# API Key ယူရန်: https://fal.ai/dashboard/keys
# ပုံဖန်တီးမှုက Credit သုံးနိုင်ပြီး အမြဲတမ်း Free မဟုတ်ပါ။
# ------------------------------------------------------------
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/fast-sdxl


# ------------------------------------------------------------
# 11. EDGE TTS - Microsoft အသံဖတ်စနစ်
# ပုံမှန်သုံးဖို့ API Key မလိုပါ။
# မြန်မာအသံ ရနိုင်မှုက Microsoft မှာ လက်ရှိရနိုင်တဲ့ Voice ပေါ်မူတည်ပါတယ်။
# Proxy မလိုရင် ဒီအပိုင်းကို မပြင်ပါနဲ့။
# ------------------------------------------------------------
# EDGE_TTS_PROXY=http://127.0.0.1:10808


# ------------------------------------------------------------
# 12. AZURE SPEECH - အခြား TTS ဝန်ဆောင်မှု
# Azure Speech Resource ဖန်တီးထားမှ သုံးလို့ရပါတယ်။
# Free Quota ရှိ/မရှိနဲ့ Region ကို ကိုယ့် Azure Account ထဲမှာ စစ်ပါ။
# ------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=


# ------------------------------------------------------------
# 13. ELEVENLABS - ဘာသာစကားမျိုးစုံ အသံထုတ်ရန်
# API Key ယူရန်: https://elevenlabs.io/
# Plan နဲ့ Character Quota အလိုက် ကန့်သတ်ချက်ရှိပြီး Paid ဖြစ်နိုင်ပါတယ်။
# ------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4

# မြန်မာစာဖတ်တဲ့အခါ အသံထွက်/နံပါတ်ပြင်ဆင်ပေးတဲ့ Burmese Voice Kit
# 1 = ဖွင့်ထားမယ်၊ 0 = ပိတ်ထားမယ်
ELEVENLABS_BURMESE_VOICE_KIT=1


# ------------------------------------------------------------
# 14. WHISPER - စကားပြောကို စာသားပြောင်းတဲ့ Model Download
# ပထမဆုံး Run တဲ့အခါ Hugging Face ကနေ Model (~460 MB) ဆွဲပါမယ်။
# ပုံမှန်အားဖြင့် HF Token မလိုပါဘူး။
# ------------------------------------------------------------

# huggingface.co မဖွင့်နိုင်တဲ့အခါမှ Mirror ကို သုံးပါ။
# HF_ENDPOINT=https://hf-mirror.com


# ============================================================
# ပြီးပါပြီ။
# API Key မရှိတဲ့ Provider တွေကို အလွတ်ထားလို့ရပါတယ်။
# မသုံးတဲ့ TTS / Image Provider တွေကိုလည်း Key မဖြည့်ဘဲ ထားနိုင်ပါတယ်။
# ============================================================
