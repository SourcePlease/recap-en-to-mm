# Copy this file to .env (same folder) and put your own Gemini API key in it.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: more keys (one Google project each) are tried in order when one is used up:
# GEMINI_IMAGE_PROJECT_1_KEY=
# GEMINI_IMAGE_PROJECT_2_KEY=

# Optional: only if Gemini needs a proxy on this PC (e.g. v2rayN). "none" = always direct.
# GEMINI_PROXY=http://127.0.0.1:10808

# Optional: Edge TTS (the Burmese voice) normally needs NO proxy - Microsoft refuses many VPN servers (403).
# Only on a network where the voice works just through a proxy: EDGE_TTS_PROXY=http://127.0.0.1:<port>
# EDGE_TTS_PROXY=

# Optional: the Whisper model (~460 MB, first run only) comes from huggingface.co. No account or
# HF_TOKEN is needed. Only if huggingface.co does not open on this PC, use a mirror:
# HF_ENDPOINT=https://hf-mirror.com


# Recap translation provider. Gemini preserves the original behavior by default.
# Set to groq, openrouter, or ollama only after configuring that provider's model/key below.
RECAP_AI_PROVIDER=gemini
# Optional comma-separated fallback providers. Only these explicitly listed providers are tried.
RECAP_AI_FALLBACKS=
RECAP_AI_TIMEOUT_SECONDS=120

# Optional Studio AI providers. Use model IDs available to your own account; hosted quotas can change.
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional local AI through Ollama (install Ollama and download a model yourself).
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=

# Optional fal.ai AI-generated thumbnail backgrounds (may use paid credits)
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/fast-sdxl


# Optional Azure Speech TTS (requires a Speech resource; check the currently available free quota).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional ElevenLabs multilingual TTS (plan/quota is account-specific).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
