# ============================================================
# RCMM - recap-en-to-mm
# ဒီဖိုင်ကို .env လို့ နာမည်ပြောင်းပြီး ကိုယ့် API Key တွေ ဖြည့်သုံးပါ။
# API Key အစစ်ပါတဲ့ .env ကို GitHub ပေါ် မတင်ပါနဲ့။
#
# အရင်ဆုံး သိထားရမယ့်အချက် -
# • FREE ဆိုတာ အကန့်အသတ်မရှိတာ မဟုတ်ပါ။ Request / Token quota ရှိပါတယ်။
# • PAID ဆိုတာ Billing ဖွင့်ထားမှ သုံးနိုင်တာ၊ ဒါမှမဟုတ် သုံးတိုင်း ငွေကျနိုင်တာပါ။
# • အောက်ပါစာရင်းက RCMM ရဲ့ OpenAI-compatible Chat / Text API မှာ သုံးလို့ရတဲ့
#   Model တွေကိုပဲ စာရင်းပြုစုထားတာပါ။ Embedding, Rerank, Speech-only နဲ့ Image-only
#   Model တွေကို Recap ဘာသာပြန် Model နဲ့ မရောထားပါဘူး။
# • Provider တွေရဲ့ Free quota နဲ့ Model စာရင်းက အချိန်မရွေး ပြောင်းနိုင်ပါတယ်။
# ============================================================


# ------------------------------------------------------------
# 1. GEMINI - RCMM Recap အတွက် Google AI
# API Key: https://aistudio.google.com/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=

# ဒီတစ်ခုက နေ့စဉ် rotation ပိတ်ထားတဲ့အခါ၊ ဒါမှမဟုတ် model list မသတ်မှတ်ထားတဲ့အခါ
# အဓိကအသုံးပြုမယ့် Default Model ဖြစ်ပါတယ်။
GEMINI_TEXT_MODEL=gemini-3.8-flash

# FREE TIER - Text / Chat အတွက် အခမဲ့စမ်းသုံးနိုင်တဲ့ Stable Models
# RCMM က တစ်နေ့တစ်ခုစီ အဓိက Model ပြောင်းသုံးပြီး Error / Quota ဖြစ်ရင်
# အဲဒီနေ့ရဲ့ ကျန် Model တွေကို အစဉ်လိုက် ဆက်စမ်းပါမယ်။
GEMINI_TEXT_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# daily = တစ်ရက်ပြောင်းတိုင်း ပထမဦးဆုံးသုံးမယ့် Model ကို နောက်တစ်ခုသို့ ရွှေ့မယ်။
# off = ရေးထားတဲ့ Model အစီအစဉ်အတိုင်းပဲ အမြဲသုံးမယ်။
GEMINI_MODEL_ROTATION=daily

# Rotation စတင်တွက်မယ့်ရက်။ 2026-11-07 မှာ ပထမ Model (Gemini 3.8) ကို စမယ်။
# နောက်တစ်ရက် 3.7၊ နောက်တစ်ရက် 3.6 ... အစဉ်လိုက် လှည့်မယ်။
# ကွန်ပျူတာရဲ့ Local Date ကို အသုံးပြုပါတယ်။
GEMINI_MODEL_ROTATION_START_DATE=2026-11-07

# အထက်က Model List ကို ကိုယ့်စိတ်ကြိုက် ပြောင်းချင်ရင်
# GEMINI_TEXT_MODELS ကိုပဲ ပြင်ပါ။ Model ID တွေကို comma နဲ့ ခွဲရေးပါ။
#
# FREE TIER MODEL LIST:
# gemini-3.8-flash
# gemini-3.7-flash
# gemini-3.6-flash
# gemini-3.5-flash
# gemini-3.5-flash-lite
# gemini-3.1-flash-lite
#
# PAID / PREVIEW / SPECIAL MODEL များ (အခမဲ့စာရင်းထဲ မထည့်ထားပါ):
# gemini-4-argon              = Paid only (Free Tier မရ)
# gemini-3.1-pro-preview      = Preview / Paid access လိုနိုင်၊ AI Studio မှာ Billing စစ်ပါ
# gemini-omni-1.1-flash       = Video generation အတွက်၊ Recap text model မဟုတ်
#
# ဒီအောက်က Model တွေက Live audio, Text-to-Speech, Image Generation စတဲ့
# သီးသန့်အလုပ်အတွက်ဖြစ်လို့ Recap ဘာသာပြန်စာသား Model စာရင်းထဲ မထည့်ပါနဲ့။
# gemini-3.8-live
# gemini-3.8-live-extended-thinking
# gemini-3.8-flash-tts
# gemini-3.8-flash-lite-tts
# gemini-3.1-flash-image
# gemini-3-pro-image
#
# Free Tier မှာ Request ကန့်သတ်ချက်ရှိပါတယ်။ Billing ဖွင့်ထားတဲ့ Paid Project
# နဲ့ Free Project က သုံးစွဲပုံ မတူနိုင်ပါ။ $0 ပဲသုံးချင်ရင် AI Studio/Google
# Cloud Project မှာ Free Tier ကိုပဲ သုံးပြီး Paid Billing မဖွင့်ထားပါနဲ့။

# Optional: ပုံဆိုင်ရာ Gemini အလုပ်တွေအတွက် Google Project Key များ
# မလိုရင် ဒီအတိုင်းထားပါ။
# GEMINI_IMAGE_PROJECT_1_KEY=
# GEMINI_IMAGE_PROJECT_2_KEY=

# Proxy လိုမှသာ ဖွင့်ပါ။ Proxy မသုံးချင်ရင် GEMINI_PROXY=none
# GEMINI_PROXY=http://127.0.0.1:10808
# GEMINI_PROXY=none


# ------------------------------------------------------------
# 2. RECAP AI - ဘယ် Provider ကို အရင်သုံးမလဲ
# ------------------------------------------------------------

# auto = API Key နဲ့ Model ပြည့်စုံတဲ့ Provider တွေထဲက အစီအစဉ်အတိုင်း သုံးမယ်။
# gemini = Gemini ကိုပဲ သုံးမယ်။ Gemini နေ့စဉ် Model Rotation ကို အပြည့်အဝသုံးမယ်။
# groq / openrouter / cloudflare / nvidia / cohere / ollama
#       = သတ်မှတ်ထားတဲ့ Provider ကို အဓိကရွေးမယ်။
RECAP_AI_PROVIDER=auto

# auto ထားတဲ့အခါ အရင်စမ်းမယ့်အစီအစဉ်
RECAP_AI_AUTO_ORDER=groq,openrouter,cloudflare,nvidia,cohere,ollama

# Provider တစ်ခု Error ဖြစ်ရင် နောက်တစ်ခုကို ဆက်စမ်းမယ်။
RECAP_AI_FALLBACKS=groq,openrouter,cloudflare,nvidia,cohere,ollama

# API တစ်ခါတောင်းဆိုမှုကို အများဆုံးစောင့်မယ့်အချိန် (စက္ကန့်)
RECAP_AI_TIMEOUT_SECONDS=120

# သတိ - Groq/OpenRouter စတာတွေကိုလည်း Key ဖြည့်ထားရင် auto က
# Gemini ထက် အဲဒီ Provider ကို အရင်ရွေးနိုင်ပါတယ်။
# Gemini ကိုပဲ တစ်နေ့တစ် Model လှည့်သုံးချင်ရင် RECAP_AI_PROVIDER=gemini လို့ထားပါ။


# ------------------------------------------------------------
# 3. GROQ - မြန်ဆန်တဲ့ AI API
# API Key: https://console.groq.com/keys
# ------------------------------------------------------------
GROQ_API_KEY=

# FREE PLAN - လက်ရှိ Free quota ရှိတဲ့ Chat Models
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=qwen/qwen3.8-27b

# အထက်က Model သုံးခုလုံး Free Plan Quota ရှိပါတယ်။
# လက်ရှိ Rate Limit က Model တစ်ခုချင်းစီ 30 RPM / 1,000 RPD /
# 8,000 TPM / 200,000 TPD ဖြစ်တယ်။ Account အလိုက် Limit ပြောင်းနိုင်ပါတယ်။

# PAID / BILLING
# Groq ရဲ့ Developer Plan ကို Upgrade လုပ်ပြီး Paid usage သုံးရင်
# အထက်က Model တွေတောင် Token အလိုက် ကျသင့်နိုင်ပါတယ်။
# Free quota ကျော်တာနဲ့ Free Plan မှာ 429 Error ပြန်လာပြီး ငွေမဖြတ်ပါ။
# Billing Upgrade ကို ကိုယ်တိုင်မလုပ်ပါနဲ့ဆိုရင် Free Plan မှာပဲ နေပါ။
#
# Not for recap translation:
# openai/gpt-oss-safeguard-20b = Safety / moderation model, ပုံမှန်ဘာသာပြန် Model မဟုတ်ပါ။
# whisper-large-v3 / whisper-large-v3-turbo = Speech-to-text ဖြစ်ပြီး ဒီ Chat Model setting မဟုတ်ပါ။


# ------------------------------------------------------------
# 4. OPENROUTER - Free Model အမျိုးမျိုးကို API တစ်ခုတည်းက သုံးရန်
# API Key: https://openrouter.ai/keys
# ------------------------------------------------------------
OPENROUTER_API_KEY=

# အကြံပြု Default - အခမဲ့ Model တွေထဲက တစ်ခုကို အလိုအလျောက် ရွေးပေးမယ်။
OPENROUTER_MODEL=openrouter/free

# FREE VARIANTS - Model ID အဆုံးမှာ :free ပါရင် Free Variant ဖြစ်ပါတယ်။
# ကိုယ်တိုင် ရွေးချင်ရင် အပေါ်က OPENROUTER_MODEL ကို # ခံပြီး ဒီထဲက တစ်ခုဖွင့်ပါ။
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
# OPENROUTER_MODEL=cohere/north-mini-code:free
# OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# OPENROUTER_MODEL=xingchen-agi/xing4.0-29b-a4b:free
# OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Crouton Alpha က $0 pricing ရှိပေမဲ့ :free variant မဟုတ်သလို
# anonymous third-party provider ဖြစ်တဲ့အတွက် Strict Free/Privacy အတွက်
# Default ထဲ မထည့်ထားပါ။
# OPENROUTER_MODEL=stealth/crouton-alpha

# PAID MODELS
# :free မပါတဲ့ ပုံမှန် Model ID အများစုက Paid ဖြစ်နိုင်ပါတယ်။
# Model Catalog မှာ $/token နဲ့ Free/On-demand အခြေအနေကို စစ်ပြီးမှ သုံးပါ။
# https://openrouter.ai/models
#
# :free variants တွေမှာ ပုံမှန်အားဖြင့် 20 RPM / 50 RPD ကန့်သတ်ချက်ရှိပါတယ်။
# $10 credit ဝယ်ထားမှ RPD မြင့်နိုင်တာကြောင့် ငွေမသုံးချင်ရင် Credit မဝယ်ပါနဲ့။
# Model စာရင်းနဲ့ Limit တွေ အမြဲပြောင်းလဲနိုင်ပါတယ်။
# Coding / Rerank / Embedding သီးသန့် Model အချို့ကို Recap ဘာသာပြန်ဖို့ မရွေးပါနဲ့။


# ------------------------------------------------------------
# 5. CLOUDFLARE WORKERS AI
# API Token: https://dash.cloudflare.com/profile/api-tokens
# Account ID: Cloudflare Dashboard မှာ ကြည့်နိုင်ပါတယ်။
# Token နဲ့ Account ID နှစ်ခုလုံး လိုပါတယ်။
# ------------------------------------------------------------
CF_API_TOKEN=
CF_ACCOUNT_ID=

# FREE PLAN - လက်ရှိ Free Worker Plan မှာ အသုံးပြုနိုင်တဲ့ Chat Models
CF_MODEL=@cf/zai-org/glm-4.7-flash
# CF_MODEL=@cf/google/gemma-4-26b-a4b-it
# CF_MODEL=@cf/nvidia/nemotron-3-120b-a12b

# Free allocation: တစ်နေ့ 10,000 Neurons (နေ့စဉ် UTC 00:00 မှာ Reset)
# Free Worker Plan မှာ Quota ကျော်ရင် request တွေ ရပ်သွားမယ်။
#
# PAID PLAN / Billing လိုအပ်တဲ့ Model များ
# CF_MODEL=@cf/moonshotai/kimi-k2.6
# CF_MODEL=@cf/moonshotai/kimi-k2.7-code
# CF_MODEL=@cf/zai-org/glm-5.2
# CF_MODEL=@cf/zai-org/glm-5.3
# CF_MODEL=@cf/zai-org/glm-5.3-flash
# CF_MODEL=@cf/deepseek-ai/deepseek-v4-flash-0731
# CF_MODEL=@cf/deepseek-ai/deepseek-v4.1-flash-1017
# CF_MODEL=@cf/deepseek-ai/deepseek-v4-pro-0813
#
# Paid Plan/AI Gateway Credits မရှိဘဲ အထက်က Paid Model တွေကို မရွေးပါနဲ့။
# Catalog: https://developers.cloudflare.com/workers-ai/models/


# ------------------------------------------------------------
# 6. NVIDIA NIM - NVIDIA Hosted AI API
# API Key/Model ရွေးရန်: https://build.nvidia.com/
# ------------------------------------------------------------
NVIDIA_API_KEY=

# FREE ENDPOINT - လက်ရှိ Free Endpoint အဖြစ် ဖော်ပြထားတဲ့ Chat/Text Models
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_MODEL=z-ai/glm-5.3-flash
# NVIDIA_MODEL=minimaxai/minimax-m3.1-flash
# NVIDIA_MODEL=stepfun-ai/step-5-preview

# Free Endpoint ဆိုတာ သတ်မှတ်ထားတဲ့ Trial / Request Limit ရှိတယ်လို့ ဆိုလိုတာပါ။
# Model တစ်ခုချင်းစီရဲ့ Model Page မှာ Free Endpoint ဆိုတာ ရှိ/မရှိ
# ကိုယ့် NVIDIA Account ထဲမှာ သေချာစစ်ပါ။ Region/Quota အလိုက် ကွာနိုင်ပါတယ်။
#
# PAID / DOWNLOADABLE ONLY
# NVIDIA Catalog မှာ Paid, Dedicated, Downloadable ဆိုပြီး ပြထားတဲ့ Model တွေကို
# ဒီ API Key နဲ့ Free API အဖြစ် ခေါ်လို့မရနိုင်ပါ။ သက်ဆိုင်ရာ Model Page ရဲ့
# Endpoint / Pricing ကို စစ်ပြီးမှ သုံးပါ။
# https://build.nvidia.com/models


# ------------------------------------------------------------
# 7. COHERE - Trial API
# API Key: https://dashboard.cohere.com/api-keys
# ------------------------------------------------------------
COHERE_API_KEY=

# FREE TRIAL - Command A+ Chat Model
COHERE_MODEL=command-a-plus-05-2026

# Trial Key: တစ်လ 1,000 API Calls / တစ်မိနစ် 20 Requests အထိ။
# Trial Limit ပြည့်ရင် နောက်လ Reset စောင့်ပါ၊ ဒါမှမဟုတ် အခြား Provider သုံးပါ။
#
# PAID / PRODUCTION
# Production/Model Vault access နဲ့ Sales Agreement လိုနိုင်ပါတယ်။
# Cohere Account မှာ Production access အတွက် Billing / Contract ကို စစ်ပါ။
# Language quality က မြန်မာဘာသာအတွက် စမ်းသပ်ပြီးမှ အဓိကထားပါ။


# ------------------------------------------------------------
# 8. OLLAMA - ကိုယ့်ကွန်ပျူတာပေါ်မှာ Local AI Run မယ်
# Download: https://ollama.com/
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# FREE / LOCAL - API သုံးခ မရှိပေမဲ့ Model Download နဲ့ စက်ရဲ့ RAM/CPU/GPU လိုတယ်။
OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_MODEL=qwen3.5:0.8b
# OLLAMA_MODEL=qwen3.5:2b
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_MODEL=qwen3.5:27b

# သုံးမယ့် Model ကို အရင် Download လုပ်ပါ။
# ဥပမာ: ollama pull qwen3.5:4b
# RCMM ကို ကိုယ့် PC မှာ Run နေမှ 127.0.0.1 ကို ချိတ်နိုင်ပါတယ်။
# Cloud မှာ RCMM Run ထားရင် 127.0.0.1 က Cloud Server ကိုပဲ ညွှန်းပါတယ်။
#
# PAID: Ollama က API Usage အတွက် သီးခြား Paid Tier မလိုပါ။
# ဒါပေမဲ့ Cloud GPU / Managed Hosting သုံးရင် အဲဒီဝန်ဆောင်မှုက ငွေကျနိုင်ပါတယ်။


# ------------------------------------------------------------
# 9. MISTRAL - ဒီ API ကို Free Plan နဲ့ သုံးလို့မရပါ
# API Key: https://console.mistral.ai/
# ------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=

# သတိ - Mistral Free Mode က Vibe/Studio အတွက်ဖြစ်ပြီး API Access မပါပါ။
# API Key နဲ့ API အသုံးပြုဖို့ Billing Activation / Pay-as-you-go လိုပါတယ်။
# အောက်က Model တွေကို သုံးရင် ငွေကျနိုင်ပါတယ်။ Free-only အတွက် မဖွင့်ပါနဲ့။
# MISTRAL_MODEL=mistral-small-2603
# MISTRAL_MODEL=mistral-medium-3-5
# MISTRAL_MODEL=mistral-large-4
# MISTRAL_MODEL=ministral-3b-2512
# MISTRAL_MODEL=ministral-8b-2512


# ------------------------------------------------------------
# 10. FAL.AI - AI ပုံ / Thumbnail Background ဖန်တီးရန်
# API Key: https://fal.ai/dashboard/keys
# ------------------------------------------------------------
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/fast-sdxl

# ဒီအပိုင်းက Text Recap Model မဟုတ်ပါဘူး။ Image Generation အတွက်ပါ။
# Credit / Usage အလိုက် ငွေကျနိုင်တဲ့အတွက် Free API Provider တွေနဲ့ မရောပါနဲ့။


# ------------------------------------------------------------
# 11. EDGE TTS - Microsoft အသံဖတ်စနစ်
# ပုံမှန်အားဖြင့် API Key မလိုပါ။ မြန်မာ Voice ရနိုင်မှုက Voice စာရင်းပေါ် မူတည်တယ်။
# ------------------------------------------------------------
# EDGE_TTS_PROXY=http://127.0.0.1:10808


# ------------------------------------------------------------
# 12. AZURE SPEECH - အပို TTS ဝန်ဆောင်မှု
# Azure Speech Resource လိုပါတယ်။ Free quota / Paid Tier ကို Account ထဲ စစ်ပါ။
# ------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=


# ------------------------------------------------------------
# 13. ELEVENLABS - Multilingual TTS / အသံထုတ်စနစ်
# API Key: https://elevenlabs.io/
# ------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4

# မြန်မာအသံထွက်နဲ့ နံပါတ်ဖတ်ပုံကို ကြိုပြင်ပေးမယ့် Burmese Voice Kit
# 1 = ဖွင့်၊ 0 = ပိတ်
ELEVENLABS_BURMESE_VOICE_KIT=1

# ElevenLabs Free plan ရှိ/မရှိ၊ Character quota ဘယ်လောက်လဲဆိုတာ
# ကိုယ့် Account/Plan ထဲမှာ စစ်ပါ။ Quota ကျော်ရင် Paid ဖြစ်နိုင်ပါတယ်။


# ------------------------------------------------------------
# 14. WHISPER - Video ထဲကအသံကို စာသားပြောင်းခြင်း
# ပထမဆုံးအကြိမ် Model ကို Hugging Face ကနေ Download လုပ်ပါမယ် (~460 MB)
# ပုံမှန်အားဖြင့် HF_TOKEN မလိုပါ။ Local inference ဖြစ်ပါတယ်။
# ------------------------------------------------------------

# huggingface.co မရောက်နိုင်တဲ့အခါမှ Mirror သုံးပါ။
# HF_ENDPOINT=https://hf-mirror.com


# ============================================================
# နောက်ဆုံးမှတ်ချက်
# • ကိုယ်အသုံးပြုမယ့် API Key တွေကိုပဲ ဖြည့်ပါ။ မသုံးတာတွေ အလွတ်ထားလို့ရတယ်။
# • Provider တစ်ခုထဲက Model တစ်ခုကိုပဲ uncomment လုပ်ပါ။
# • Gemini Model Rotation သုံးချင်ရင် RECAP_AI_PROVIDER=gemini လို့ရွေးပါ။
# • Free Quota ကျော်ရင် တခြား Free Provider ကို Fallback သုံးနိုင်ပါတယ်။
# • Key အစစ်ပါတဲ့ .env ကို GitHub ပေါ် မတင်ပါနဲ့။
# ============================================================
