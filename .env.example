# ============================================================
# RCMM (recap-en-to-mm) - Environment configuration
# Copy this file to .env. Do NOT commit your real .env or API keys.
# ရှင်းလင်းချက်များကို မြန်မာ + English နှစ်ဘာသာဖြင့် ရေးထားသည်။
# ============================================================


# ------------------------------------------------------------
# 1) GEMINI - Recap / fallback provider
# Free API key: https://aistudio.google.com/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=

# Free-tier model (default)
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

# Other current Gemini model IDs (check AI Studio pricing/quota before use):
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# GEMINI_TEXT_MODEL=gemini-3.7-flash

# Optional: extra Google project keys for image-related requests
# GEMINI_IMAGE_PROJECT_1_KEY=
# GEMINI_IMAGE_PROJECT_2_KEY=

# Optional proxy. Set to "none" to force direct connection.
# GEMINI_PROXY=http://127.0.0.1:10808
# GEMINI_PROXY=none


# ------------------------------------------------------------
# 2) RECAP AI ROUTING
# auto = use the first provider with BOTH an API key and a model ID.
# If no alternate provider is configured, it falls back to Gemini.
# ------------------------------------------------------------
RECAP_AI_PROVIDER=auto

# Free-first order. Mistral is intentionally omitted because its free
# allowance is account/credit based, not an unlimited free model quota.
RECAP_AI_AUTO_ORDER=groq,openrouter,cloudflare,nvidia,cohere,ollama

# Try other configured compatible providers when the selected one fails.
RECAP_AI_FALLBACKS=groq,openrouter,cloudflare,nvidia,cohere,ollama

RECAP_AI_TIMEOUT_SECONDS=120


# ------------------------------------------------------------
# 3) GROQ - hosted API, Free plan has rate limits
# API key: https://console.groq.com/keys
# ------------------------------------------------------------
GROQ_API_KEY=

# Free-plan model options listed by Groq:
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-120b

# Current paid Developer-plan model (NOT a strict-free choice):
# GROQ_MODEL=qwen/qwen3.8-27b

# Groq Free tier is quota-limited. Do not upgrade the account to a
# paid Developer plan unless you intend to enable pay-as-you-go billing.


# ------------------------------------------------------------
# 4) OPENROUTER - use only free model routing / free model IDs
# API key: https://openrouter.ai/keys
# ------------------------------------------------------------
OPENROUTER_API_KEY=

# Recommended: automatically route to an available free model.
OPENROUTER_MODEL=openrouter/free

# Or choose ONE currently listed free model ID instead:
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_MODEL=cohere/north-mini-code:free

# Free variants are rate-limited; model availability can change:
# https://openrouter.ai/collections/free-models


# ------------------------------------------------------------
# 5) CLOUDFLARE WORKERS AI - Free allocation: 10,000 Neurons/day
# Requires API Token AND Account ID.
# API token: https://dash.cloudflare.com/profile/api-tokens
# ------------------------------------------------------------
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Workers Free plan model options:
CF_MODEL=@cf/zai-org/glm-4.7-flash
# CF_MODEL=@cf/google/gemma-4-26b-a4b-it
# CF_MODEL=@cf/nvidia/nemotron-3-120b-a12b

# Some newer/larger models require Workers Paid; check the model catalog
# before changing the model ID:
# https://developers.cloudflare.com/workers-ai/models/


# ------------------------------------------------------------
# 6) NVIDIA NIM - Free Endpoints (quota / availability may vary)
# API key and model access: https://build.nvidia.com/
# ------------------------------------------------------------
NVIDIA_API_KEY=

# Verified Free Endpoint / model ID:
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Note: NVIDIA model card lists English, Spanish, French, German,
# Italian and Japanese as supported languages; Burmese is not listed.
# Test output quality before using it for Myanmar translation.


# ------------------------------------------------------------
# 7) COHERE - Trial API / limited usage
# API key: https://dashboard.cohere.com/api-keys
# ------------------------------------------------------------
COHERE_API_KEY=

# Current Command A+ model ID:
COHERE_MODEL=command-a-plus-05-2026

# Cohere's published language list for this model does not list Burmese.
# Test Burmese translation quality before relying on it.


# ------------------------------------------------------------
# 8) OLLAMA - Local AI only (no hosted API charge)
# Install Ollama and pull the selected model on the same machine.
# https://ollama.com/
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Choose ONE model and make sure it is downloaded locally:
OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_MODEL=qwen3.5:0.8b
# OLLAMA_MODEL=qwen3.5:2b
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_MODEL=qwen3.5:27b

# Note: localhost points to the machine running RCMM.
# On a cloud deployment, it points to the cloud server, not your PC.


# ------------------------------------------------------------
# 9) MISTRAL - optional limited free allowance / credits
# Not included in the default free-first order.
# Check your account's remaining credits and billing settings first.
# API key: https://console.mistral.ai/
# ------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=

# Current chat model IDs (priced API models; may consume account credits):
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_MODEL=ministral-3b-latest
# MISTRAL_MODEL=ministral-8b-latest
# The separately marked free Leanstral endpoint is code-specialized,
# so it is not recommended for recap translation:
# MISTRAL_MODEL=labs-leanstral-2603


# ------------------------------------------------------------
# 10) FAL.AI - AI-generated thumbnail/image backgrounds
# Optional. Image generation can consume paid credits.
# API key: https://fal.ai/dashboard/keys
# ------------------------------------------------------------
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/fast-sdxl


# ------------------------------------------------------------
# 11) EDGE TTS - Microsoft Edge TTS
# Normally no API key and no proxy are required.
# Burmese voice support depends on the available Edge voices.
# ------------------------------------------------------------
# EDGE_TTS_PROXY=http://127.0.0.1:10808


# ------------------------------------------------------------
# 12) AZURE SPEECH - optional TTS service
# Requires an Azure Speech resource. Free quota depends on the account.
# ------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=


# ------------------------------------------------------------
# 13) ELEVENLABS - optional multilingual TTS
# Plan and character quota are account-specific; may be paid.
# ------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4

# Use bundled Burmese Voice Kit pronunciation/number preprocessing.
# 1 = enabled, 0 = disabled
ELEVENLABS_BURMESE_VOICE_KIT=1


# ------------------------------------------------------------
# 14) WHISPER MODEL DOWNLOAD
# First run downloads the model from Hugging Face (~460 MB).
# No HF_TOKEN is normally required.
# ------------------------------------------------------------
# Use a mirror only if huggingface.co cannot be reached:
# HF_ENDPOINT=https://hf-mirror.com


# ============================================================
# END - Only fill the providers you actually plan to use.
# API keys belong in your local .env / Streamlit Secrets, never Git.
# ============================================================
